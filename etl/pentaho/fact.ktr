    <connection>DataEngineeringOltp</connection>
    <sql>SELECT
  id
, name
, olt.host_id
, latitude
, longitude
, room_type
, price
, minimum_nights
, number_of_reviews
, last_review
, reviews_per_month
, availability_365
FROM oltp_airbnb.mytable olt
JOIN projectdataeng_olap.hostdim hd ON hd.host_id = olt.host_id
JOIN projectdataeng_olap.neighborhooddim nd
  ON nd.neighbourhood = olt.neighbourhood COLLATE utf8mb4_general_ci</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
